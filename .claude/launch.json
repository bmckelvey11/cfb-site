{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "CFB System Maker (web)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "cfb_system_maker",
        "web"
      ],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "Redpanda Overs (site)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "models/over_zero/site",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Docs (static)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8777",
        "--directory",
        "docs"
      ],
      "port": 8777
    },
    {
      "name": "Dive Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        ".dive-preview",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Exports (static)",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8778",
        "--directory",
        "data/exports"
      ],
      "port": 8778
    },
    {
      "name": "Tuning Lab",
      "runtimeExecutable": ".venv-lab-ui/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "models/tuning/ui/app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501"
      ],
      "port": 8501,
      "url": "http://127.0.0.1:8501"
    },
    {
      "name": "Matchup page",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "cfb_system_maker",
        "matchup"
      ],
      "port": 5050,
      "autoPort": true
    },
    {
      "name": "Marimo",
      "runtimeExecutable": "marimo",
      "runtimeArgs": [
        "edit",
        "marimo.py",
        "--headless",
        "--no-token"
      ],
      "port": 2718,
      "autoPort": true
    }
  ]
}
